<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.PopularAction" parent="Widget.MaterialComponents.ExtendedFloatingActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">136dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/popular_updates_light</item>
        <item name="cornerRadius">24dp</item>
    </style>
    <color name="popular_updates_light">#2863A0</color>
    <color name="popular_updates_dark">#A8C9ED</color>
    <color name="popular_previous_light">#715298</color>
    <color name="popular_previous_dark">#D1BCEB</color>
    <color name="popular_action_dark_text">#17212E</color>
    <string name="popular_updates_only">Updates only</string>
    <string name="popular_show_all">Show all</string>
    <string name="popular_previous">Previous popular</string>
    <string name="popular_return_current">Current popular</string>
    <string name="popular_no_previous">No previous popular request is saved yet</string>
    <string name="popular_no_updates">No new galleries since the previous popular request</string>
</resources>
