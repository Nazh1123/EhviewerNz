<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/translation_progress_panel"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_gravity="top|left"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="@dimen/gallery_notice_margin_top"
    android:layout_marginRight="16dp"
    android:alpha="0.45"
    android:background="@drawable/bg_reader_translation_progress"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp"
    android:visibility="gone"
    tools:ignore="RtlHardcoded">

    <TextView
        android:id="@+id/translation_result_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/translation_page_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:contentDescription="@string/translation_title"
        android:importantForAccessibility="yes"
        android:indeterminate="false"
        android:layoutDirection="ltr"
        android:max="1000"
        android:progressBackgroundTint="#44FFFFFF"
        android:progressTint="@android:color/white"
        tools:progress="350" />

    <ProgressBar
        android:id="@+id/translation_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="yes"
        android:indeterminate="false"
        android:layoutDirection="ltr"
        android:progressBackgroundTint="#44FFFFFF"
        android:progressTint="@android:color/white"
        tools:progress="33" />

</LinearLayout>
