<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="?attr/dialogPreferredPadding"
        android:paddingEnd="?attr/dialogPreferredPadding"
        android:paddingBottom="16dp">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/auto_subscription_updates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/settings_fork_auto_subscription_updates"
            app:switchPadding="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/preference_child_indent"
            android:orientation="vertical">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/auto_subscription_updates_eh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_fork_auto_subscription_updates_eh"
                app:switchPadding="16dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/auto_subscription_updates_bookmark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/settings_fork_auto_subscription_updates_bookmark"
                app:switchPadding="16dp" />

            <LinearLayout
                android:id="@+id/auto_subscription_update_interval_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/auto_subscription_update_interval_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="2"
                    android:labelFor="@id/auto_subscription_update_interval"
                    android:text="@string/subscription_update_interval_minutes" />

                <EditText
                    android:id="@+id/auto_subscription_update_interval"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:maxLength="10"
                    android:selectAllOnFocus="true"
                    android:singleLine="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- Homepage scanning is disabled; retain the controls for reference.
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/subscription_homepage_scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/settings_subscription_homepage_scan"
            app:switchPadding="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_subscription_homepage_scan_summary"
            android:textAppearance="?android:attr/textAppearanceSmall" />
        -->

    </LinearLayout>
</ScrollView>
