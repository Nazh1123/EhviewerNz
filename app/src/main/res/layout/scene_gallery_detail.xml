<!--内容详情页-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hippo.ehviewer.ui.scene.gallery.detail.GalleryDetailScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <include layout="@layout/gallery_detail_content" />

    </com.hippo.ehviewer.ui.scene.gallery.detail.GalleryDetailScrollView>

    <com.hippo.widget.ProgressView
        android:id="@+id/progress_view"
        style="@style/ProgressView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <TextView
        android:id="@+id/tip"
        android:layout_width="228dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:drawablePadding="8dp"
        style="@style/TextAppearance.AppCompat.Medium"/>

    <View
        android:id="@+id/swipe_preview_indicator"
        android:layout_width="4dp"
        android:layout_height="0dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="12dp"
        android:alpha="0"
        android:visibility="invisible"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/back_to_top"
        style="@style/Widget.Design.FloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/corner_fab_margin"
        android:layout_marginBottom="@dimen/corner_fab_margin"
        android:contentDescription="@string/gallery_detail_back_to_top"
        android:visibility="gone"
        app:backgroundTint="?attr/widgetColorThemePrimary"
        app:srcCompat="@drawable/v_back_to_top_dark_x24" />

</FrameLayout>
