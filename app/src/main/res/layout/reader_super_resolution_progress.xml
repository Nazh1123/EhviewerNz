<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/super_resolution_progress_panel"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_gravity="top|left"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="@dimen/gallery_notice_margin_top"
    android:layout_marginRight="16dp"
    android:alpha="0.45"
    android:background="@drawable/bg_reader_translation_progress"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:layoutDirection="ltr"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:visibility="gone"
    tools:ignore="RtlHardcoded">

    <LinearLayout
        android:id="@+id/super_resolution_progress_bars"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/super_resolution_page_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:contentDescription="@string/sr_title"
            android:importantForAccessibility="yes"
            android:indeterminate="false"
            android:layoutDirection="ltr"
            android:max="100"
            android:progressBackgroundTint="#44FFFFFF"
            android:progressTint="@android:color/white" />

        <ProgressBar
            android:id="@+id/super_resolution_queue_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/sr_title"
            android:importantForAccessibility="yes"
            android:indeterminate="false"
            android:layoutDirection="ltr"
            android:progressBackgroundTint="#44FFFFFF"
            android:progressTint="@android:color/white" />
    </LinearLayout>

    <ImageView
        android:id="@+id/super_resolution_progress_icon"
        android:layout_width="24dp"
        android:layout_height="40dp"
        android:layout_marginLeft="4dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/v_super_resolution_x24"
        android:tint="@android:color/white"
        android:visibility="gone" />
</LinearLayout>
