<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    style="@style/CardView.Normal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.hippo.ehviewer.widget.TileThumbNew
                android:id="@+id/thumb_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:foreground="@drawable/tile_background"
                android:scaleType="centerCrop"
                app:retryType="none" />

            <TextView
                android:id="@+id/category"
                android:layout_width="32dp"
                android:layout_height="24dp"
                android:layout_gravity="top|right" />

            <TextView
                xmlns:tools="http://schemas.android.com/tools"
                android:id="@+id/simple_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|right"
                android:layout_marginRight="2dp"
                android:textColor="@android:color/white"
                android:textSize="10dp"
                android:textStyle="bold"
                tools:ignore="SpUsage" />

            <ImageView
                android:id="@+id/downloaded"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|right"
                android:layout_marginRight="4dp"
                android:layout_marginBottom="4dp"
                android:alpha="0.75"
                android:contentDescription="@string/download_state_downloaded"
                android:visibility="gone"
                app:srcCompat="@drawable/v_download_badge_x24" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/thumbnail_info_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/contentColorReactive"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingTop="2dp"
            android:paddingEnd="5dp"
            android:paddingBottom="1dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/thumbnail_posted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/thumbnail_censorship"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp"
                android:translationX="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/thumbnail_downloaded"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/download_state_downloaded"
                    android:visibility="gone"
                    app:srcCompat="@drawable/v_download_x16" />

                <TextView
                    android:id="@+id/thumbnail_pages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/selection_outline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gallery_selection_outline"
        android:clickable="false"
        android:elevation="8dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="9dp"
            android:layout_marginBottom="9dp"
            android:background="@drawable/gallery_selection_mark_background"
            android:contentDescription="@null"
            android:padding="2dp"
            app:srcCompat="@drawable/v_check_contrast_x24" />
    </FrameLayout>

</androidx.cardview.widget.CardView>
