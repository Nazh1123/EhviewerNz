<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hippo.lib.glview.view.GLRootView
        android:id="@+id/gl_root_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.hippo.ehviewer.widget.GalleryHeader
        android:id="@+id/gallery_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top">

        <com.hippo.widget.TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right"
            android:layout_marginTop="@dimen/gallery_widget_margin_v"
            android:layout_marginRight="@dimen/gallery_widget_margin_h"
            android:textColor="?android:attr/textColorSecondary"
            tools:ignore="RtlHardcoded" />

        <com.hippo.ehviewer.widget.StrokeTextView
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/gallery_widget_margin_v"
            app:stroke_color="@android:color/black"
            app:stroke_width="0.5dp"
            android:textColor="?android:attr/textColorSecondary" />

        <com.hippo.widget.BatteryView
            android:id="@+id/battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="left"
            android:layout_marginLeft="@dimen/gallery_widget_margin_h"
            android:layout_marginTop="@dimen/gallery_widget_margin_v"
            android:drawablePadding="4dp"
            app:color="?android:attr/textColorSecondary"
            app:warningColor="@color/red_500"
            tools:ignore="RtlHardcoded" />

    </com.hippo.ehviewer.widget.GalleryHeader>

    <LinearLayout
        android:id="@+id/quick_settings_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="?attr/gallerySliderBackgroundColor"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:visibility="invisible">

        <ImageButton
            android:id="@+id/quick_screen_orientation"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_read_screen_rotation"
            android:padding="12dp"
            android:src="@drawable/v_screen_portrait_x24" />

        <ImageButton
            android:id="@+id/quick_reading_direction"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_read_reading_direction"
            android:padding="12dp"
            android:src="@drawable/v_arrow_left_x24" />

        <ImageButton
            android:id="@+id/quick_direct_save"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_read_direct_save"
            android:padding="12dp"
            android:src="@drawable/v_save_x24" />

        <ImageButton
            android:id="@+id/quick_page_turn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_read_quick_page_turn"
            android:padding="12dp"
            android:src="@drawable/v_fast_forward_x24" />

        <ImageButton
            android:id="@+id/quick_animated_webp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_animated_webp_controls"
            android:padding="12dp"
            android:src="@drawable/v_animated_webp_x24" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:fitsSystemWindows="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/auto_transfer"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:importantForAccessibility="no"
            android:visibility="invisible"
            android:layout_gravity="end"
            android:src="@drawable/ic_start_play_24" />

        <com.hippo.ehviewer.widget.SeekBarPanel
            android:id="@+id/seek_bar_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/gallerySliderBackgroundColor"
            android:orientation="horizontal"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:visibility="invisible">

            <TextView
                android:id="@+id/left"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_horizontal" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1">

                <com.hippo.ehviewer.widget.ReversibleSeekBar
                    android:id="@+id/seek_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical" />

            </FrameLayout>

            <TextView
                android:id="@+id/right"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="center_horizontal" />

        </com.hippo.ehviewer.widget.SeekBarPanel>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/animated_webp_panel"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/animated_webp_controls"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="18dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/animated_webp_play_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.25" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/animated_webp_speed_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.75" />

            <com.hippo.ehviewer.widget.StrokeTextView
                android:id="@+id/animated_webp_time"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:fontFamily="sans-serif-condensed"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="00:00/00:00"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:stroke_color="@android:color/black"
                app:stroke_width="2dp" />

            <ImageButton
                android:id="@+id/animated_webp_play_pause"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_animated_webp_control"
                android:contentDescription="@string/animated_webp_play_pause"
                android:padding="6dp"
                android:src="@drawable/v_pause_x24"
                android:tint="@android:color/white"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/animated_webp_play_guide"
                app:layout_constraintStart_toStartOf="@id/animated_webp_play_guide"
                app:layout_constraintTop_toTopOf="parent" />

            <Button
                android:id="@+id/animated_webp_speed"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_animated_webp_control"
                android:backgroundTint="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="1x"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/animated_webp_speed_guide"
                app:layout_constraintStart_toStartOf="@id/animated_webp_speed_guide"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <SeekBar
            android:id="@+id/animated_webp_seek"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_gravity="bottom"
            android:contentDescription="@string/animated_webp_progress"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingTop="2dp"
            android:paddingEnd="0dp"
            android:paddingBottom="0dp"
            android:splitTrack="false" />

    </FrameLayout>

    <com.hippo.widget.ColorView
        android:id="@+id/mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
