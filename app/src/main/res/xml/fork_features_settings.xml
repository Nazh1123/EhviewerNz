<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/settings_fork_category_read">

        <com.hippo.preference.SwitchPreference
            android:defaultValue="true"
            android:key="reader_page_preview"
            android:title="@string/settings_reader_page_preview"
            android:summary="@string/settings_reader_page_preview_summary"
            app:allowDividerAbove="false" />

        <Preference
            android:key="manual_image_save_location"
            android:title="@string/settings_download_manual_save_location"
            app:allowDividerAbove="true" />

        <com.hippo.preference.SwitchPreference  
            android:defaultValue="true"
            android:key="use_local_timezone"
            android:summary="@string/settings_eh_use_local_timezone_summary"
            android:title="@string/settings_eh_use_local_timezone" />
            
    <!-- Retired switches: use key bindings.

        <com.hippo.preference.SwitchPreference
            android:defaultValue="false"
            android:key="gallery_direct_save"
            android:summary="@string/settings_fork_long_press_save_summary"
            android:title="@string/settings_read_direct_save" />

        <com.hippo.preference.SwitchPreference
            android:defaultValue="false"
            android:dependency="gallery_direct_save"
            android:key="gallery_quick_save_turn_page"
            android:summary="@string/settings_fork_long_press_save_then_turn_page_summary"
            android:title="@string/settings_read_long_press_save_turn_page" />

        <com.hippo.preference.SwitchPreference
            android:defaultValue="false"
            android:key="gallery_quick_page_turn"
            android:summary="@string/settings_fork_quick_page_turn_summary"
            android:title="@string/settings_read_quick_page_turn" />
    -->

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_fork_category_animated_webp"
        app:allowDividerAbove="true">

        <com.hippo.preference.SwitchPreference
            android:defaultValue="true"
            android:key="experimental_animated_webp"
            android:summary="@string/settings_animated_webp_controls_summary"
            android:title="@string/settings_animated_webp_controls"
            app:allowDividerAbove="false" />

        <com.hippo.preference.SwitchPreference
            android:defaultValue="true"
            android:dependency="experimental_animated_webp"
            android:key="animated_webp_show_time"
            android:summary="@string/settings_animated_webp_playback_time_summary"
            android:title="@string/settings_animated_webp_playback_time"
            app:allowDividerAbove="false" />

        <com.hippo.preference.SwitchPreference
            android:defaultValue="true"
            android:dependency="experimental_animated_webp"
            android:key="animated_webp_allow_seek"
            android:summary="@string/settings_animated_webp_progress_control_summary"
            android:title="@string/settings_animated_webp_progress_control"
            app:allowDividerAbove="false" />

        <com.hippo.preference.SwitchPreference
            android:defaultValue="false"
            android:dependency="experimental_animated_webp"
            android:key="animated_webp_auto_advance"
            android:summary="@string/settings_animated_webp_sequential_playback_summary"
            android:title="@string/settings_animated_webp_sequential_playback"
            app:allowDividerAbove="false" />

        <com.hippo.preference.SwitchPreference
            android:defaultValue="false"
            android:dependency="experimental_animated_webp"
            android:key="animated_webp_auto_transfer_button"
            android:summary="@string/settings_animated_webp_auto_transfer_button_summary"
            android:title="@string/settings_animated_webp_auto_transfer_button"
            app:allowDividerAbove="false" />

        <androidx.preference.EditTextPreference
            android:defaultValue="2.0"
            android:dependency="experimental_animated_webp"
            android:key="animated_webp_long_press_speed"
            android:summary="@string/settings_animated_webp_long_press_speed_summary"
            android:title="@string/settings_animated_webp_long_press_speed"
            app:allowDividerAbove="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/settings_fork_category_downloads">

        <com.hippo.preference.SwitchPreference
            android:defaultValue="false"
            android:key="mobile_browsing_priority"
            android:summary="@string/settings_download_mobile_browsing_priority_summary"
            android:title="@string/settings_download_mobile_browsing_priority"
            app:allowDividerAbove="false" />

        <com.hippo.preference.SwitchPreference
            android:defaultValue="false"
            android:key="download_label_continuous_browse"
            android:summary="@string/settings_fork_download_label_continuous_browse_summary"
            android:title="@string/settings_fork_download_label_continuous_browse"
            app:allowDividerAbove="false" />

        <Preference
            android:key="fork_delete_empty_galleries"
            android:summary="@string/settings_download_delete_missing_galleries_summary"
            android:title="@string/settings_fork_delete_empty_galleries"
            app:allowDividerAbove="true" />

        <Preference
            android:key="update_gallery_versions"
            android:summary="@string/settings_update_downloaded_gallery_versions_summary"
            android:title="@string/settings_update_downloaded_gallery_versions"
            app:allowDividerAbove="true" />

        <com.hippo.ehviewer.preference.DeleteOldGalleryVersionsPreference
            android:key="delete_old_gallery_versions"
            android:summary="@string/settings_delete_old_gallery_versions_summary"
            android:title="@string/settings_delete_old_gallery_versions"
            app:allowDividerAbove="true" />

    </PreferenceCategory>

</PreferenceScreen>
