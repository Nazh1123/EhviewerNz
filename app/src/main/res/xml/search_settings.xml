<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.hippo.preference.SwitchPreference
        android:defaultValue="true"
        android:key="enable_search_tag_chips"
        android:title="@string/settings_enable_search_tag_chips"
        android:summary="@string/settings_enable_search_tag_chips_summary"
        app:allowDividerAbove="false" />

    <com.hippo.preference.SwitchPreference
        android:defaultValue="true"
        android:dependency="enable_search_tag_chips"
        android:key="enable_search_preset_tags"
        android:title="@string/settings_enable_search_preset_tags"
        android:summary="@string/settings_search_preset_bubbles_summary"
        app:allowDividerAbove="false" />

    <Preference
        android:key="search_preset_tags"
        android:dependency="enable_search_preset_tags"
        android:title="@string/settings_search_preset_tags"
        app:fragment="com.hippo.ehviewer.ui.fragment.SearchPresetsFragment"
        app:allowDividerAbove="false" />

    <com.hippo.preference.SwitchPreference
        android:defaultValue="false"
        android:key="show_viewed_galleries"
        android:title="@string/settings_show_viewed_galleries"
        android:summary="@string/settings_show_viewed_galleries_summary"
        app:allowDividerAbove="true" />

    <com.hippo.preference.SwitchPreference
        android:defaultValue="false"
        android:key="popular_updates_only"
        android:title="@string/settings_popular_updates_only"
        android:summary="@string/settings_popular_updates_only_summary"
        app:allowDividerAbove="true" />

    <com.hippo.preference.SwitchPreference
        android:defaultValue="true"
        android:key="enable_precise_rating_filter"
        android:title="@string/settings_enable_precise_rating_filter"
        app:allowDividerAbove="true" />

    <Preference
        android:key="persistent_min_rating_hundredths"
        android:dependency="enable_precise_rating_filter"
        android:title="@string/settings_persistent_min_rating"
        android:summary="@string/settings_persistent_min_rating_description"
        app:allowDividerAbove="false" />

    <com.hippo.preference.ThumbnailSizePreference
        android:defaultValue="1"
        android:key="thumb_size"
        android:summary="%s"
        android:title="@string/settings_eh_cover_thumb_size"
        app:entries="@array/cover_thumb_size_entries"
        app:entryValues="@array/cover_thumb_size_entry_values"
        app:allowDividerAbove="true" />

    <com.hippo.preference.ThumbnailSizePreference
        android:defaultValue="1"
        android:key="preview_thumb_size"
        android:summary="%s"
        android:title="@string/settings_eh_preview_thumb_size"
        app:entries="@array/preview_thumb_size_entries"
        app:entryValues="@array/preview_thumb_size_entry_values"
        app:allowDividerAbove="false" />

    <com.hippo.preference.SwitchPreference
        android:defaultValue="false"
        android:key="show_thumbnail_info_bar"
        android:summary="@string/settings_eh_show_thumbnail_info_bar_summary"
        android:title="@string/settings_eh_show_thumbnail_info_bar" />

    <com.hippo.preference.SwitchPreference
        android:defaultValue="false"
        android:dependency="show_thumbnail_info_bar"
        android:key="show_thumbnail_info_title"
        android:title="@string/settings_eh_show_thumbnail_info_title"
        app:allowDividerAbove="false" />

    <com.hippo.preference.SwitchPreference
        android:defaultValue="false"
        android:dependency="show_thumbnail_info_bar"
        android:key="show_thumbnail_info_details"
        android:title="@string/settings_eh_show_thumbnail_info_details"
        app:allowDividerAbove="false" />

    <com.hippo.preference.SwitchPreference
        android:defaultValue="false"
        android:dependency="show_thumbnail_info_details"
        android:key="show_thumbnail_info_highlight"
        android:title="@string/settings_eh_show_thumbnail_info_highlight"
        app:allowDividerAbove="false" />

    <com.hippo.preference.SwitchPreference
        android:defaultValue="true"
        android:key="show_thumbnail_download_badge"
        android:summary="@string/settings_eh_show_thumbnail_download_badge_summary"
        android:title="@string/settings_eh_show_thumbnail_download_badge"
        app:allowDividerAbove="false" />

    <com.hippo.preference.SwitchPreference
        android:defaultValue="false"
        android:key="gallery_long_press_quick_download"
        android:summary="@string/settings_gallery_long_press_quick_download_summary"
        android:title="@string/settings_gallery_long_press_quick_download" />

    <com.hippo.preference.SwitchPreference
        android:defaultValue="true"
        android:key="gallery_preview_immediate_jump"
        android:summary="@string/settings_eh_gallery_preview_immediate_jump_summary"
        android:title="@string/settings_fork_gallery_immediate_jump" />

</PreferenceScreen>
