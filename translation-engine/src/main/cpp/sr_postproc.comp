// Adapted from nihui/waifu2x-ncnn-vulkan (MIT), revision 64914665.
// Quantize on the GPU; zero alpha marks invalid (NaN/Inf) output for CPU fallback.
#version 450
layout(binding = 0) readonly buffer Tensor { sfp values[]; };
layout(binding = 1) writeonly buffer Destination { uint pixels[]; };
layout(push_constant) uniform Params {
    int width; int step; int outWidth; int outHeight; int offsetX; int tileWidth;
} p;
void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= p.tileWidth || y >= p.outHeight) return;
    int index = y * p.width + x;
    vec3 value = vec3(float(buffer_ld1(values, index)), float(buffer_ld1(values, p.step + index)),
                      float(buffer_ld1(values, p.step * 2 + index)));
    uint rgba = 0u;
    if (!any(isnan(value)) && !any(isinf(value))) {
        uvec3 rgb = uvec3(clamp(floor(value * 255.0 + 0.5), vec3(0.0), vec3(255.0)));
        rgba = rgb.r | (rgb.g << 8) | (rgb.b << 16) | 0xff000000u;
    }
    pixels[y * p.outWidth + x + p.offsetX] = rgba;
}
